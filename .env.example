# LLM Provider: auto | gemini | groq | huggingface | anthropic
# auto = picks first key found (gemini → groq → huggingface → anthropic)
REACT_APP_LLM_PROVIDER=auto

# --- FREE OPTIONS (recommended — pick ONE) ---

# Gemini Flash — FREE, 60 req/min, no credit card (2026: gemini-flash-latest, gemini-2.5-flash)
# Get key at https://aistudio.google.com/app/apikey
# REACT_APP_GEMINI_API_KEY=your_gemini_key_here
# REACT_APP_GEMINI_MODEL=gemini-flash-latest

# Groq — FREE, ~14k req/day, fast Llama
# Get key at https://console.groq.com/keys
# REACT_APP_GROQ_API_KEY=your_groq_key_here
# REACT_APP_GROQ_MODEL=llama-3.1-8b-instant

# Hugging Face Inference — FREE with HF token
# Get token at https://huggingface.co/settings/tokens
# REACT_APP_HUGGINGFACE_API_KEY=your_hf_token_here
# REACT_APP_HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# --- PAID OPTION (optional) ---
# Anthropic Claude — $5 free credit for new accounts
# Get key at https://console.anthropic.com/
# REACT_APP_ANTHROPIC_API_KEY=your_anthropic_key_here
# REACT_APP_ANTHROPIC_MODEL=claude-3-haiku-20240307
